API_URL=https://api.example.com
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token
MAPBOX_DOWNLOADS_TOKEN=sk.your_mapbox_secret_token

# RevenueCat (get keys from https://app.revenuecat.com)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_your_ios_api_key
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_your_android_api_key
EXPO_PUBLIC_IS_ON_REVIEW=true

# Force-update screen — where the "Actualizar" button sends the user
EXPO_PUBLIC_APP_STORE_URL=itms-apps://itunes.apple.com/app/idYOUR_APP_ID
EXPO_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.tributcr.app