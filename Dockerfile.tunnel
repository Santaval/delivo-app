# Dockerfile optimized for Coolify with Expo Tunnel support
# This version uses Expo's tunnel feature for reliable remote access

FROM node:20-alpine

# Set working directory
WORKDIR /app

# Install dependencies required for Expo, tunnel, and ngrok
RUN apk add --no-cache \
    git \
    bash \
    curl

# Copy package files
COPY package.json package-lock.json* ./

# Install dependencies
RUN npm install

# Install Expo CLI and ngrok globally for tunnel support
RUN npm install -g @expo/ngrok expo-cli

# Copy the rest of the application
COPY . .

# Expose Expo development server ports
EXPOSE 8081 19000 19001 19002

# Set environment variables
ENV EXPO_DEVTOOLS_LISTEN_ADDRESS=0.0.0.0
ENV CI=1

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8081/status || exit 1

# Start with tunnel mode for reliable remote access through Coolify
CMD ["npx", "expo", "start", "--tunnel", "--port", "8081"]
