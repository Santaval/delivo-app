{
  "expo": {
    "name": "Delivo",
    "slug": "tributcr-app",
    "version": "1.2.2",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "com.tributcr.savaldev",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tributcr.savaldev",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Delivo utiliza tu ubicación mientras la aplicación está abierta para mostrar tu posición en tiempo real en el mapa de reparto, calcular rutas desde donde te encuentras y permitirte guardar la dirección de un cliente utilizando tu ubicación actual. Por ejemplo, al iniciar un reparto, tu ubicación establece el punto de partida para las indicaciones paso a paso hacia tu primera parada y actualiza tu posición en el mapa a medida que conduces."
      }
    },
    "android": {
      "package": "com.tributcr.savaldev",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "react-native-maps",
        {
          "config": {
            "googleMapsApiKey": "AIzaSyAxQa4j4xoQKW5Srn9tIbbnr3IYhAMakW8"
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false
        }
      ],
      "expo-localization",
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-status-bar",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "delivo"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4fe7762f-e464-4d93-be69-0a531e5fd77e"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4fe7762f-e464-4d93-be69-0a531e5fd77e"
    }
  }
}
